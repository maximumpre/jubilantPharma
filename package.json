{
  "name": "jubilant-pharma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "npm run prebuild && next build",
    "build:astro": "astro build && node scripts/sync-astro-pages.mjs",
    "astro:watch": "node scripts/astro-watch.mjs",
    "predev": "npm run build:astro",
    "prebuild": "npm run build:astro && node scripts/audit-steins-gate.mjs . && node scripts/audit-crawler-seo.mjs . && node scripts/audit-brand-assets.mjs . && node scripts/audit-error-screen.mjs . && node scripts/check-indexnow-key.mjs && node scripts/check-brand-assets.mjs && node scripts/check-meta-description.mjs && node scripts/check-canonical-domain.mjs && node scripts/audit-neon-database.mjs .",
    "postbuild": "node scripts/notify-indexnow.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@astrojs/react": "^4.4.2",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astro": "^5.18.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
