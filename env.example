# Jubilant Pharma / Aptia HOLL08 — example env keys (placeholders ONLY).
# Copy to .env.local and fill real values. Never commit live secrets.

# ── Bundle 1 — Ops Telegram ──
TELEGRAM_BOT_TOKEN=123456:ABC-REPLACE-WITH-BOT-TOKEN
TELEGRAM_CHAT_ID=111,222
ADMIN_PORTAL_URL=https://your-control-center-deploy.example.com

# ── Bundle 2 — SEO admin Telegram ──
TELEGRAM_SEO_BOT_TOKEN=789012:XYZ-REPLACE-WITH-SEO-BOT-TOKEN
TELEGRAM_SEO_ADMIN=333,444

# ── Bundle 3 — Neon storage (bot audit + pending-login) ──
# Official primary: DATABASE_URL (no CC_ID). Shared: DB_2…DB_10 (CC_ID). No DB_1.
DATABASE_URL=postgresql://user:pass@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
